# Caddy automatski pribavlja i obnavlja TLS sertifikat. Access log nije uključen.
relay.example.com {
	# Only TLS 1.3: modern ciphers with forward secrecy, which every supported iOS version speaks.
	tls {
		protocols tls1.3
	}
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
